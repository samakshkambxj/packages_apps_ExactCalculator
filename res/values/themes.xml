<resources>

    <style name="Theme" parent="Theme.Material3Expressive.DayNight">
        <item name="android:statusBarColor">@color/ios_black</item>
        <item name="colorPrimary">@color/modern_primary</item>
        <item name="colorSecondary">@color/modern_primary</item>
        <item name="colorTertiary">@color/modern_primary</item>
        <item name="calculatorDisplayStartColor">@color/ios_black</item>
        <item name="calculatorDisplayEndColor">@color/ios_black</item>
        <item name="calculatorFormulaTextColor">@color/ios_display_formula</item>
        <item name="calculatorResultTextColor">@color/ios_white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/ios_black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- iOS keypad palette (always dark, like the iOS calculator). -->
        <item name="iosDigitBackground">@color/ios_digit_bg</item>
        <item name="iosDigitForeground">@color/ios_digit_text</item>
        <item name="iosFuncBackground">@color/ios_func_bg</item>
        <item name="iosFuncForeground">@color/ios_func_text</item>
        <item name="iosOperatorBackground">@color/ios_op_bg</item>
        <item name="iosOperatorForeground">@color/ios_op_text</item>
        <item name="iosOperatorActiveBackground">@color/ios_op_text</item>
        <item name="iosOperatorActiveForeground">@color/ios_op_bg</item>
    </style>

    <style name="Theme.Calculator">
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="android:layoutDirection">ltr</item>
    </style>

    <style name="Theme.Licenses" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">?colorSurface</item>
        <item name="android:windowLightStatusBar">?isLightTheme</item>
        <item name="android:navigationBarColor">?colorSurface</item>
        <item name="android:windowLightNavigationBar">?isLightTheme</item>
    </style>

    <style name="Theme.Button" parent="ThemeOverlay.Material3Expressive.Button.TextButton">
    </style>

    <style name="Theme.Button.Advanced">
        <item name="colorContainer">?colorSurface</item>
        <item name="colorOnContainer">?colorOnSurface</item>
    </style>

    <style name="Theme.Button.Numeric">
        <item name="colorContainer">?colorSurfaceContainer</item>
        <item name="colorOnContainer">?colorOnSurface</item>
    </style>

    <style name="Theme.Button.Operator">
        <item name="colorContainer">?colorSecondaryContainer</item>
        <item name="colorOnContainer">?colorOnSecondaryContainer</item>
    </style>

    <style name="Theme.Button.Clear">
        <item name="colorContainer">?colorSurfaceVariant</item>
        <item name="colorOnContainer">?colorOnSurfaceVariant</item>
    </style>

    <style name="Theme.Button.Action">
        <item name="colorContainer">?colorPrimaryContainer</item>
        <item name="colorOnContainer">?colorOnPrimaryContainer</item>
    </style>



    <style name="Theme.Calculator.Vintage" parent="Theme.Calculator">
        <item name="colorPrimary">#B86B24</item>
        <item name="colorSecondary">#8A5A2B</item>
        <item name="colorTertiary">#A94B2D</item>
        <item name="colorSurface">#F2E5CF</item>
        <item name="colorSurfaceContainer">#E7D5B8</item>
        <item name="colorSurfaceContainerHigh">#F7EBD7</item>
        <item name="colorSurfaceVariant">#D8C4A5</item>
        <item name="colorOnSurface">#2B2117</item>
        <item name="colorOnSurfaceVariant">#685441</item>
        <item name="colorPrimaryContainer">#E7A15B</item>
        <item name="colorOnPrimaryContainer">#2B1607</item>
        <item name="colorSecondaryContainer">#D9C09B</item>
        <item name="colorOnSecondaryContainer">#2C2117</item>
        <item name="calculatorDisplayStartColor">#D5D5B5</item>
        <item name="calculatorDisplayEndColor">#F0EACF</item>
        <item name="calculatorFormulaTextColor">#332B1D</item>
        <item name="calculatorResultTextColor">#11100D</item>
        <item name="android:statusBarColor">#F2E5CF</item>
        <item name="android:navigationBarColor">#F2E5CF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Vintage keeps the pre-iOS keypad palette. -->
        <item name="iosDigitBackground">?colorSurfaceContainer</item>
        <item name="iosDigitForeground">?colorOnSurface</item>
        <item name="iosFuncBackground">?colorSurfaceVariant</item>
        <item name="iosFuncForeground">?colorOnSurfaceVariant</item>
        <item name="iosOperatorBackground">?colorSecondaryContainer</item>
        <item name="iosOperatorForeground">?colorOnSecondaryContainer</item>
        <item name="iosOperatorActiveBackground">?colorSecondaryContainer</item>
        <item name="iosOperatorActiveForeground">?colorOnSecondaryContainer</item>
    </style>
</resources>
